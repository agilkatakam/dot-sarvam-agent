# Copy to .env and fill in. This file stays on the server; the key is never sent to callers.
# Settings marked (dashboard) are only the starting defaults: change them later on /admin, no restart.

# Sarvam AI key (free ₹100 signup credit, never expires): https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Brand named in the mandatory AI disclosure
ORG_NAME=Dot

# Protects /dashboard, /studio and /admin. Leave the default only on your own machine.
DASHBOARD_PASSWORD=change-me

# Hard cap on simultaneous calls (protects your credit). Sarvam Starter allows 20 STT streams.
MAX_CONCURRENT_CALLS=3

# --- Starting defaults for the (dashboard) settings
SARVAM_LLM_MODEL=sarvam-105b-conversations
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_VOICE=shubh
# en-IN for Indian English, hi-IN for Hindi/Hinglish, or "auto"
SARVAM_STT_LANGUAGE=en-IN
# transcribe | codemix (codemix = Hinglish kept as spoken)
SARVAM_STT_MODE=transcribe
# smart (on-device Smart Turn model, faster) | sarvam (Sarvam's server decides after a silence)
TURN_MODE=smart
MAX_CALL_SECONDS=300
IDLE_HANGUP_SECS=30

# --- Meetings
# Without Google set up, bookings go to the built-in calendar (Admin page + .ics invites).
# To book into Google Calendar: see scripts/connect_google_calendar.py.
TIMEZONE=Asia/Kolkata
MEETING_MINUTES=20
WORKING_HOURS_START=10:00
WORKING_HOURS_END=17:00
WORKING_DAYS=mon,tue,wed,thu,fri
BOOKING_MIN_LEAD_HOURS=2
BOOKING_HORIZON_DAYS=21
GOOGLE_CALENDAR_ID=primary
# Comma separated; added as guests on every booked meeting (e.g. the sales lead).
MEETING_TEAM_EMAILS=

# --- Cost estimate (INR per unit, ex-GST, Sarvam's published rates)
PRICE_STT_INR_PER_HOUR=30
PRICE_TTS_INR_PER_1K_CHARS=3
PRICE_LLM_INR_PER_1M_INPUT=29
PRICE_LLM_INR_PER_1M_OUTPUT=73

# Optional: real phone path via a Twilio trial number (callers must be verified in Twilio).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

PORT=7860
# Where calls.db, recordings and dashboard settings are kept (default ./data)
# DATA_DIR=
